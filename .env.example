PORT=5000

# MongoDB Atlas connection settings
DB_HOST=cluster0.your-host.mongodb.net
DB_NAME=SereneSoulYogaDBV1
DB_USER=your_db_username
# If your password has special characters, keep it as-is here;
# the server will URL-encode it automatically.
DB_PASSWORD=your_db_password

# Alternatively, provide a full connection string instead of the above:
# MONGODB_URI=mongodb+srv://your_db_username:your_db_password@cluster0.your-host.mongodb.net/?retryWrites=true&w=majority

# Dev only: if you want to run against a local MongoDB instance without credentials
# set this to true and ensure MongoDB is running locally.
# USE_LOCAL_MONGO=true

# Stripe secret key (use a test key for development)
PAYMENT_KEY=sk_test_your_stripe_secret_key
